generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  customer
  provider_user
  platform_admin
}

enum AppointmentStatus {
  requested
  pending_provider_approval
  pending_master_approval
  confirmed
  rejected
  reschedule_requested
  cancelled_by_customer
  cancelled_by_provider
  completed
  no_show
  expired
}

enum SuggestionStatus {
  pending
  approved
  rejected
  edited
  cancelled
}

enum NotificationChannel {
  in_app
  push_fcm
  email
  sms
  whatsapp
}

enum ReviewModerationStatus {
  pending
  approved
  hidden
  reported
  rejected
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

model User {
  id                 String               @id @default(cuid())
  email              String?              @unique
  phone              String?              @unique
  name               String
  userType           UserType
  locale             String               @default("tr")
  timezone           String               @default("Asia/Nicosia")
  passwordHash       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  customer           Customer?
  staffMemberships   StaffMember[]
  notifications      Notification[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  approvedAuditLogs  AuditLog[]           @relation("AuditApprover")
  createdSuggestions SecretarySuggestion[] @relation("SuggestionRequester")
}

model Customer {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes        String?
  appointments Appointment[]
  reviews      Review[]
  favorites    Favorite[]
  follows      ProviderFollower[]
  waitlist     WaitlistEntry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Clinic {
  id            String             @id @default(cuid())
  name          String
  legalName     String?
  taxNumber     String?
  locations     ProviderLocation[]
  providers     Provider[]
  staffMembers  StaffMember[]
  subscriptions Subscription[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Provider {
  id                    String                 @id @default(cuid())
  clinicId              String?
  clinic                Clinic?                @relation(fields: [clinicId], references: [id])
  ownerUserId           String
  verificationStatus    String                 @default("pending")
  responseRate          Decimal                @default(0)
  cancellationRate      Decimal                @default(0)
  noShowRate            Decimal                @default(0)
  profileCompleteness   Int                    @default(0)
  profile               ProviderProfile?
  services              Service[]
  staffMembers          StaffMember[]
  appointments          Appointment[]
  availability          CalendarAvailability[]
  exceptions            CalendarException[]
  blocks                CalendarBlock[]
  suggestions           SecretarySuggestion[]
  reviews               Review[]
  locations             ProviderLocation[]
  followers             ProviderFollower[]
  favorites             Favorite[]
  waitlist              WaitlistEntry[]
  subscription          Subscription?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model ProviderProfile {
  id             String     @id @default(cuid())
  providerId     String     @unique
  provider       Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  displayName    String
  title          String
  bio            String
  experience     String?
  certificates   Json?
  languages      String[]
  socialLinks    Json?
  gallery         Json?
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  specialtyId    String
  specialty      Specialty  @relation(fields: [specialtyId], references: [id])
  onlineEnabled  Boolean    @default(false)
  inPersonEnabled Boolean   @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Category {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  icon        String?
  specialties Specialty[]
  profiles    ProviderProfile[]
  createdAt   DateTime          @default(now())
}

model Specialty {
  id          String            @id @default(cuid())
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String            @unique
  profiles    ProviderProfile[]
  services    Service[]
}

model Service {
  id              String        @id @default(cuid())
  providerId      String
  provider        Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialtyId     String?
  specialty       Specialty?    @relation(fields: [specialtyId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  bufferMinutes   Int           @default(0)
  priceCents      Int?
  currency        String        @default("TRY")
  onlineEnabled   Boolean       @default(false)
  inPersonEnabled Boolean       @default(true)
  active          Boolean       @default(true)
  appointments    Appointment[]
}

model StaffMember {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String?
  provider    Provider?  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinicId    String?
  clinic      Clinic?    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role       @relation(fields: [roleId], references: [id])
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@unique([userId, providerId])
  @@unique([userId, clinicId])
}

model Role {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  description     String?
  rolePermissions RolePermission[]
  staffMembers    StaffMember[]
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  group           String
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Appointment {
  id                 String                     @id @default(cuid())
  customerId         String
  customer           Customer                   @relation(fields: [customerId], references: [id])
  providerId         String
  provider           Provider                   @relation(fields: [providerId], references: [id])
  serviceId          String
  service            Service                    @relation(fields: [serviceId], references: [id])
  status             AppointmentStatus          @default(requested)
  startsAt           DateTime
  endsAt             DateTime
  timezone           String                     @default("Asia/Nicosia")
  customerNote       String?
  providerNote       String?
  statusHistory      AppointmentStatusHistory[]
  suggestions        SecretarySuggestion[]
  review             Review?
  notifications      Notification[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([providerId, startsAt, endsAt])
  @@index([customerId, startsAt])
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  oldStatus     AppointmentStatus?
  newStatus     AppointmentStatus
  changedById   String?
  reason        String?
  createdAt     DateTime          @default(now())
}

model CalendarAvailability {
  id              String   @id @default(cuid())
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  startTime       String
  endTime         String
  timezone        String   @default("Asia/Nicosia")
  serviceDuration Int?
  bufferMinutes   Int      @default(0)
  active          Boolean  @default(true)

  @@unique([providerId, dayOfWeek, startTime, endTime])
}

model CalendarException {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  isVacation  Boolean  @default(false)
  timezone    String   @default("Asia/Nicosia")
}

model CalendarBlock {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([providerId, startsAt, endsAt])
}

model SecretarySuggestion {
  id            String           @id @default(cuid())
  actionType    String
  requestedById String
  requestedBy   User             @relation("SuggestionRequester", fields: [requestedById], references: [id])
  providerId    String
  provider      Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  oldValue      Json?
  newValue      Json
  masterDecision String?
  status        SuggestionStatus @default(pending)
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?
}

model Notification {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?          @relation(fields: [appointmentId], references: [id])
  channel       NotificationChannel
  title         String
  body          String
  actionPayload Json?
  readAt        DateTime?
  scheduledFor  DateTime?
  sentAt        DateTime?
  retryCount    Int                   @default(0)
  createdAt     DateTime              @default(now())
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  eventKey  String
  enabled   Boolean             @default(true)

  @@unique([userId, channel, eventKey])
}

model Review {
  id               String                 @id @default(cuid())
  appointmentId    String                 @unique
  appointment      Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id])
  providerId       String
  provider         Provider               @relation(fields: [providerId], references: [id])
  rating           Int
  comment          String?
  tags             String[]
  moderationStatus ReviewModerationStatus @default(pending)
  replies          ReviewReply[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  customerId String
  providerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, providerId])
}

model ProviderFollower {
  customerId String
  providerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, providerId])
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  monthlyCents  Int?
  annualCents   Int?
  currency      String         @default("TRY")
  features      Json
  limits        Json
  subscriptions Subscription[]
}

model Subscription {
  id              String             @id @default(cuid())
  providerId      String?            @unique
  provider        Provider?          @relation(fields: [providerId], references: [id])
  clinicId        String?
  clinic          Clinic?            @relation(fields: [clinicId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus
  billingInterval String
  trialEndsAt     DateTime?
  currentPeriodEnd DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  actor          User     @relation("AuditActor", fields: [actorUserId], references: [id])
  actorRole      String
  actionType     String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  approvalStatus String?
  approvedById   String?
  approvedBy     User?    @relation("AuditApprover", fields: [approvedById], references: [id])
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, timestamp])
}

model Location {
  id                String             @id @default(cuid())
  city              String
  district          String?
  address           String?
  latitude          Decimal?
  longitude         Decimal?
  providerLocations ProviderLocation[]
}

model ProviderLocation {
  id         String    @id @default(cuid())
  providerId String
  provider   Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinicId   String?
  clinic     Clinic?   @relation(fields: [clinicId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  label      String?
  active     Boolean   @default(true)
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId   String?
  preferredFrom DateTime?
  preferredTo DateTime?
  status      String   @default("waiting")
  createdAt   DateTime @default(now())
}
